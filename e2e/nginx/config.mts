/*
 * Writes the nginx configuration for playwright.nginx.config.ts, made of the three nginx blocks of README.md (the
 * proxy snippet, the `http` block part and the `server` block part), so the tests check the documented configuration
 * itself. Only the upstream port, the static files folder and the snippet path are changed; they must be found, so
 * the README and this script can't silently drift apart. nginx runs as the current user, with all its files in
 * e2e/.nginx.
 *
 *     E2E_PORT=3100 E2E_PUBLIC_URL=http://localhost:3200 node e2e/nginx/config.mts
 */
import { mkdirSync, readFileSync, writeFileSync } from 'node:fs'
import { dirname, join } from 'node:path'

const root = join(dirname(new URL(import.meta.url).pathname), '..', '..')
const dir = join(root, 'e2e', '.nginx')
const appPort = Number(process.env.E2E_PORT ?? 3100)
const nginxPort = Number(new URL(process.env.E2E_PUBLIC_URL ?? 'http://localhost:3200').port)

function replace(text: string, from: string, to: string) {
    if (!text.includes(from))
        throw new Error(`README nginx example no longer contains ${JSON.stringify(from)}, update e2e/nginx/config.mts`)
    return text.replaceAll(from, to)
}

const readme = readFileSync(join(root, 'README.md'), 'utf8')
const section = readme.slice(readme.indexOf('### 4. Front web server'), readme.indexOf('### Updating'))
const blocks = [...section.matchAll(/```nginx\n([\s\S]*?)```/g)].map(match => match[1])
if (blocks.length !== 3)
    throw new Error(`Expected 3 nginx blocks in the README front web server section, found ${blocks.length}`)
const [proxy, http, server] = blocks

mkdirSync(join(dir, 'snippets'), { recursive: true })
mkdirSync(join(dir, 'logs'), { recursive: true })
mkdirSync(join(dir, 'temp'), { recursive: true })
writeFileSync(join(dir, 'snippets', 'galleria-proxy.conf'), replace(proxy, '127.0.0.1:3000', `127.0.0.1:${appPort}`))

let serverBlock = replace(server, '/path/to/galleria-js/.docker/static/', `${join(root, '.next', 'static')}/`)
serverBlock = replace(serverBlock, 'include snippets/galleria-proxy.conf;', `include ${join(dir, 'snippets', 'galleria-proxy.conf')};`)

writeFileSync(join(dir, 'nginx.conf'), `# Generated by e2e/nginx/config.mts from README.md
pid ${join(dir, 'nginx.pid')};
error_log ${join(dir, 'logs', 'error.log')};
# Not from the README: parallel tests open hundreds of connections, and each needs one to the app too
events {
    worker_connections 4096;
}
http {
    access_log ${join(dir, 'logs', 'access.log')};
    client_body_temp_path ${join(dir, 'temp', 'body')};
    proxy_temp_path ${join(dir, 'temp', 'proxy')};
    fastcgi_temp_path ${join(dir, 'temp', 'fastcgi')};
    uwsgi_temp_path ${join(dir, 'temp', 'uwsgi')};
    scgi_temp_path ${join(dir, 'temp', 'scgi')};

${http}
    server {
        listen 127.0.0.1:${nginxPort};
        server_name localhost;

${serverBlock}
    }
}
`)
console.log(join(dir, 'nginx.conf'))
