{
    "name": "galleria",
    "version": "1.4.0",
    "scripts": {
        "dev": "next dev --port 3000",
        "build": "next build",
        "start": "next start",
        "docker-build": "sudo docker compose build && sudo docker tag galleria galleria:$npm_package_version",
        "docker-deploy": "sudo docker compose up -d",
        "lint": "eslint .",
        "typecheck": "next typegen && tsc --noEmit",
        "test:e2e": "playwright test",
        "test:e2e:nginx": "E2E_BASE_PATH=/photos E2E_PUBLIC_URL=http://localhost:3200 playwright test -c playwright.nginx.config.ts",
        "test:e2e:photos": "node e2e/fixtures/generate-photos.mts"
    },
    "author": "Andrey Novikov",
    "license": "GPL-3.0",
    "description": "Local photo storage react gallery",
    "overrides": {
        "react": "$react",
        "react-dom": "$react-dom",
        "archiver": {
            "readdir-glob": "^4.0.0"
        }
    },
    "dependencies": {
        "@next/third-parties": "^16.4.6",
        "archiver": "^8.0.0",
        "better-auth": "^1.7.27",
        "cookies-next": "^6.1.1",
        "exifr": "^7.1.3",
        "lodash.debounce": "^4.0.8",
        "modern-normalize": "^3.0.1",
        "moment": "^2.31.0",
        "next": "^16.4.6",
        "next-intl": "^4.14.9",
        "postgres": "^4.1.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-photo-album": "^3.6.2",
        "react-spinners": "^0.17.1",
        "react-tagcloud": "^2.3.3",
        "sharp": "^0.35.5",
        "swiper": "^14.4.0",
        "ua-parser-js": "^2.0.10",
        "utf8": "^3.0.0",
        "yet-another-react-lightbox": "^3.33.1"
    },
    "devDependencies": {
        "@next/env": "^16.4.6",
        "@playwright/test": "^1.65.1",
        "@types/archiver": "^8.0.0",
        "@types/lodash.debounce": "^4.0.9",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-tagcloud": "^2.3.2",
        "@types/utf8": "^3.0.3",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.4.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.73.0"
    }
}
